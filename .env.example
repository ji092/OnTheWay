# 실제 값은 .env.local에 직접 입력하세요. 이 파일에는 이름만 둡니다.

# 카카오 REST API 키 (서버 전용 — 길찾기·장소 검색)
KAKAO_REST_KEY=

# 카카오 JS 키 (브라우저 노출됨 — 카카오 개발자 콘솔에서 도메인 제한 필수)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 오피넷(한국석유공사) 무료 API 키 — 고급휘발유 취급 주유소·판매가격 조회
OPINET_API_KEY=

# 선택: 하루 호출 예산. 미설정 시 카카오 500 / 오피넷 1200
KAKAO_DAILY_BUDGET=
OPINET_DAILY_BUDGET=
